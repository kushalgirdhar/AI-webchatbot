# This is a .gitignore file that specifies which files and directories should be ignored by Git version control. 
# It includes patterns for Python files, virtual environments, environment variables, Qdrant storage, model/cache files, generated data, IDE configurations, and operating system files.
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
myenv/
venv/
.venv/

# Environment variables
.env
.env.*

# Qdrant local storage
qdrant_storage/

# Local Qdrant binary
qdrant

# Model/cache files
models/
.cache/
huggingface_cache/

# Generated data
data/raw/
data/chunks/

# IDE
.vscode/

# OS
.DS_Store
Thumbs.db
